#
# NotolibraEngine.framework: Chromium's //content with our embedding API
# (api/ne_engine.h), plan.md §2.1-§2.5. Phase 0: built on //content (not yet
# //chrome); pages render without a window and reach the app as IOSurfaces from
# Viz's frame capturer.

import("//build/apple/tweak_info_plist.gni")
import("//chrome/version.gni")
import("//build/config/mac/rules.gni")
import("//tools/grit/repack.gni")
import("//third_party/icu/config.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//ui/gl/features.gni")
import("//v8/gni/v8.gni")
import("//mojo/public/tools/bindings/mojom.gni")

assert(is_mac, "Phase 0 is macOS only")

_framework_name = "NotolibraEngine"
_helper_name = "Notolibra Engine Helper"

group("engine") {
  deps = [ ":framework" ]
}

mojom("mojom") {
  sources = [ "frame_agent.mojom" ]
}

source_set("engine_sources") {
  sources = [
    "api.mm",
    "browser_client.cc",
    "browser_client.h",
    "browser_context.cc",
    "browser_context.h",
    "engine.h",
    "main_delegate.h",
    "main_delegate.mm",
    "tab.h",
    "tab.mm",
    "view_bridge.h",
    "view_bridge.mm",
    "tab_ui.mm",
    "download_delegate.cc",
    "download_delegate.h",
    "request_filter.cc",
    "request_filter.h",
    "renderer/frame_agent.cc",
    "renderer/frame_agent.h",
    "renderer/renderer_client.cc",
    "renderer/renderer_client.h",
  ]
  include_dirs = [ "//notolibra/api" ]
  defines = [
    "NE_IMPLEMENTATION",
    "NE_CHROMIUM_VERSION=\"$chrome_version_full\"",
    "NE_CHROMIUM_MAJOR=\"$chrome_version_major\"",
  ]
  deps = [
    "//base",
    # RenderWidgetHostViewMac, for the view bridge (patches/embedder-ns-view).
    "//content/browser:for_content_tests",
    ":mojom",
    "//components/download/public/common:public",
    "//mojo/public/cpp/bindings",
    "//services/network/public/mojom",
    "//third_party/blink/public:blink",
    "//components/embedder_support:user_agent",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/browser:keychain_key_provider",
    "//components/os_crypt/common:keychain_password_mac",
    "//net",
    "//services/network/public/cpp",
    "//skia",
    "//ui/base/clipboard",
    "//components/input",
    "//components/viz/host",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    "//media/capture/mojom:video_capture",
    "//services/network/public/mojom",
    "//services/viz/privileged/mojom",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/range",
    "//url",
  ]
  frameworks = [
    "AppKit.framework",
    "IOSurface.framework",
  ]
}

# The engine's resources: content's, blink's, net's and ui's .paks (the inputs
# of content_shell.pak, without content_shell's own and its test resources).
repack("pak") {
  output = "$root_out_dir/notolibra_engine.pak"
  sources = [
    "$root_gen_dir/base/tracing/protos/tracing_proto_resources.pak",
    "$root_gen_dir/components/ukm_resources.pak",
    "$root_gen_dir/content/browser/resources/media/media_internals_resources.pak",
    "$root_gen_dir/content/browser/tracing/tracing_resources.pak",
    "$root_gen_dir/content/browser/webrtc/resources/webrtc_internals_resources.pak",
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/histograms_resources.pak",
    "$root_gen_dir/content/process_resources.pak",
    "$root_gen_dir/content/quota_internals_resources.pak",
    "$root_gen_dir/content/service_worker_resources.pak",
    "$root_gen_dir/content/traces_internals_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_lottie_resources.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]
  deps = [
    "//base/tracing/protos:chrome_track_event_resources",
    "//components/ukm/debug:resources",
    "//content:content_resources",
    "//content/browser/resources",
    "//content/browser/resources/media:resources",
    "//content/browser/tracing:resources",
    "//content/browser/webrtc/resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]
}

bundle_data("framework_resources") {
  sources = [
    "$root_out_dir/notolibra_engine.pak",
    "//ui/gl/resources/angle-metal/gpu_shader_cache.bin",
  ]
  public_deps = [ ":pak" ]
  if (icu_use_data_file) {
    sources += [ "$root_out_dir/icudtl.dat" ]
    deps = [ "//third_party/icu:icudata" ]
  }
  if (v8_use_external_startup_data) {
    public_deps += [ "//v8" ]
    if (use_v8_context_snapshot) {
      sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
      public_deps += [ "//tools/v8_context_snapshot" ]
    }
  }
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

bundle_data("framework_libraries") {
  sources = [
    "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
    "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
    "$root_out_dir/vulkan_intermediates/libvulkan.dylib",
  ]
  public_deps = [
    "//ui/gl:swiftshader_vk_library_copy",
    "//ui/gl:vulkan_loader_library_copy",
  ]
  if (!use_static_angle) {
    sources += [
      "$root_out_dir/egl_intermediates/libEGL.dylib",
      "$root_out_dir/egl_intermediates/libGLESv2.dylib",
    ]
    public_deps += [ "//ui/gl:angle_library_copy" ]
  }
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
}

bundle_data("framework_helpers") {
  sources = [ "$root_out_dir/$_helper_name.app" ]
  public_deps = [ ":helper_app" ]
  outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
}

mac_framework_bundle("framework") {
  output_name = _framework_name
  framework_version = "A"
  framework_contents = [
    "Helpers",
    "Libraries",
    "Resources",
  ]
  info_plist = "framework-Info.plist"
  deps = [
    ":engine_sources",
    "//third_party/icu:icudata",
  ]
  bundle_deps = [
    ":framework_helpers",
    ":framework_libraries",
    ":framework_resources",
  ]

  # Only the ne_* API is exported.
  ldflags = [
    "-Wl,-install_name,@rpath/$_framework_name.framework/$_framework_name",
    "-Wl,-exported_symbols_list," +
        rebase_path("exported_symbols.txt", root_build_dir),
  ]
  inputs = [ "exported_symbols.txt" ]
  if (is_component_build) {
    # The framework is at out/<dir>/NotolibraEngine.framework/Versions/A/: up
    # to the output directory for the component dylibs.
    ldflags += [ "-Wl,-rpath,@loader_path/../../.." ]
  }
}

mac_app_bundle("helper_app") {
  output_name = _helper_name
  sources = [ "helper_main.cc" ]
  include_dirs = [ "//notolibra/api" ]
  info_plist = "helper-Info.plist"
  deps = [
    ":framework+link_nested",
    "//base/allocator:early_zone_registration_apple",
    "//sandbox/mac:seatbelt",
  ]
  if (is_component_build) {
    # NotolibraEngine.framework/Versions/A/Helpers/<helper>.app/Contents/MacOS:
    # seven levels up is the output directory, where the framework and the
    # component dylibs are.
    ldflags = [ "-Wl,-rpath,@executable_path/../../../../../../.." ]
  }
}
