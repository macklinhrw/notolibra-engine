+void MessagePumpNSApplication::Attach(Delegate* delegate) {
+  CHECK(!attached_);
+  CHECK(NSApp.running) << "attach from inside -[NSApplication run]";
+  attached_ = true;
+  SetDelegate(delegate);
+  OnAttach();
+}
+
+void MessagePumpNSApplication::Detach() {
+  if (!attached_) {
+    return;
+  }
+  attached_ = false;
+  SetDelegate(nullptr);
+  OnDetach();
+}
+
+void AttachCurrentUIThreadToNSApplicationLoop() {
+  auto* sequence_manager =
+      sequence_manager::internal::SequenceManagerImpl::GetCurrent();
+  CHECK(sequence_manager);
+  sequence_manager->AttachToMessagePump();
+}
