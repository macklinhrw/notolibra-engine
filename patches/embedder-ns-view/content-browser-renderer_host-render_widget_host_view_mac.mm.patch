+remote_cocoa::mojom::RenderWidgetHostNSView*
+RenderWidgetHostViewMac::SetEmbedderNSView(
+    remote_cocoa::mojom::RenderWidgetHostNSView* view) {
+  if (disconnected_ || remote_ns_view_) {
+    return nullptr;
+  }
+  ns_view_ = view ? view : in_process_ns_view_bridge_.get();
+  // An embedder view set after the compositor's last frame starts with it.
+  if (view) {
+    if (const gfx::CALayerParams* params =
+            browser_compositor_->GetLastCALayerParams()) {
+      view->SetCALayerParams(params->CloneWithoutFence());
+    }
+  }
+  return in_process_ns_view_bridge_.get();
+}
