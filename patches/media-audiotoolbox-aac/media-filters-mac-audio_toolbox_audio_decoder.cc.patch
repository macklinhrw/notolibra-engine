+// Returns the size of the ADTS header to skip if `data` is exactly one ADTS
+// frame, or 0. MSE's MP4 parser and the MPEG-2 TS and ADTS parsers deliver
+// ordinary AAC frames with an ADTS header; FFmpeg's demuxer delivers raw
+// frames. AudioToolbox's MPEG-4 AAC decoder wants raw frames. xHE-AAC never
+// has ADTS headers (its object type doesn't fit in one).
+size_t AdtsHeaderSize(base::span<const uint8_t> data) {
+  if (data.size() < kADTSHeaderMinSize) {
+    return 0;
+  }
+  // 12-bit syncword, then ID (either), then layer, which is always 0.
+  if (data[0] != 0xFF || (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t frame_length = ((static_cast<size_t>(data[3]) & 0x03) << 11) |
+                              (static_cast<size_t>(data[4]) << 3) |
+                              (static_cast<size_t>(data[5]) >> 5);
+  // number_of_raw_data_blocks_in_frame: AudioToolbox gets one block per call.
+  if (frame_length != data.size() || (data[6] & 0x03) != 0) {
+    return 0;
+  }
+  const size_t header_size =
+      (data[1] & 0x01) ? kADTSHeaderSizeNoCrc : kADTSHeaderSizeWithCrc;
+  return header_size < data.size() ? header_size : 0;
+}
+
+// Builds a two-byte AAC-LC AudioSpecificConfig (ISO/IEC 14496-3 §1.6.2.1)
+// for streams that arrive without one. Returns an empty vector if the sample
+// rate or channel count has no AudioSpecificConfig code.
+std::vector<uint8_t> MakeAacLcAudioSpecificConfig(
+    const AudioDecoderConfig& config) {
+  const auto rate = std::ranges::find(kADTSFrequencyTable,
+                                      config.samples_per_second());
+  if (rate == kADTSFrequencyTable.end()) {
+    return {};
+  }
+  const int frequency_index =
+      static_cast<int>(rate - kADTSFrequencyTable.begin());
+  const int channels = config.channels();
+  const int channel_config =
+      (channels >= 1 && channels <= 6) ? channels : (channels == 8 ? 7 : 0);
+  if (!channel_config) {
+    return {};
+  }
+  constexpr int kAudioObjectTypeAacLc = 2;
+  const uint16_t asc = (kAudioObjectTypeAacLc << 11) | (frequency_index << 7) |
+                       (channel_config << 3);
+  return {static_cast<uint8_t>(asc >> 8), static_cast<uint8_t>(asc & 0xFF)};
+}
+
+// Picks the highest-quality layer of an MPEG-4 AAC stream that macOS can
+// decode, e.g. HE-AAC v2 rather than its AAC-LC core. Apple documents that
+// kAudioFormatProperty_FormatList returns a stream's layers best first, and
+// kAudioFormatProperty_FirstPlayableFormatFromList picks the first one the
+// system can play. Leaves `format` unchanged if either query fails.
+void SelectBestAacLayer(const std::vector<uint8_t>& magic_cookie,
+                        AudioStreamBasicDescription* format) {
+  AudioFormatInfo info = {};
+  info.mASBD = *format;
+  info.mMagicCookie = magic_cookie.data();
+  info.mMagicCookieSize = magic_cookie.size();
+
+  UInt32 size = 0;
+  if (AudioFormatGetPropertyInfo(kAudioFormatProperty_FormatList, sizeof(info),
+                                 &info, &size) != noErr ||
+      size < sizeof(AudioFormatListItem)) {
+    return;
+  }
+  std::vector<AudioFormatListItem> items(size / sizeof(AudioFormatListItem));
+  size = items.size() * sizeof(AudioFormatListItem);
+  if (AudioFormatGetProperty(kAudioFormatProperty_FormatList, sizeof(info),
+                             &info, &size, items.data()) != noErr) {
+    return;
+  }
+  items.resize(size / sizeof(AudioFormatListItem));
+  if (items.empty()) {
+    return;
+  }
+
+  UInt32 index = 0;
+  UInt32 index_size = sizeof(index);
+  if (AudioFormatGetProperty(kAudioFormatProperty_FirstPlayableFormatFromList,
+                             items.size() * sizeof(AudioFormatListItem),
+                             items.data(), &index_size, &index) != noErr ||
+      index >= items.size()) {
+    index = 0;
+  }
+  *format = items[index].mASBD;
 }
 
