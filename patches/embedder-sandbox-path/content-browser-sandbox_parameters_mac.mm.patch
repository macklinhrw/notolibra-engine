   CHECK(serializer->SetBooleanParameter(
       sandbox::policy::kParamDisableSandboxDenialLogging, !enable_logging));
 
+  // Notolibra: an embedder's framework can live outside the host app's
+  // bundle (a downloaded component, or a development build); its folder is
+  // then what child processes read (helpers, resources, libraries).
+  base::FilePath sandbox_bundle = base::apple::MainBundlePath();
+  const base::FilePath framework = base::apple::FrameworkBundlePath();
+  if (!framework.empty() && !sandbox_bundle.IsParent(framework)) {
+    sandbox_bundle = framework.DirName();
+  }
   std::string bundle_path =
-      sandbox::policy::GetCanonicalPath(base::apple::MainBundlePath()).value();
+      sandbox::policy::GetCanonicalPath(sandbox_bundle).value();
   CHECK(
       serializer->SetParameter(sandbox::policy::kParamBundlePath, bundle_path));
 
