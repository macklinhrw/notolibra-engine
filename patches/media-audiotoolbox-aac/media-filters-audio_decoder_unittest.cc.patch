         return params_.codec == AudioCodec::kOpus;
+      case AudioDecoderType::kFFmpeg:
+        // Builds may leave FFmpeg's AAC decoder out and decode AAC with the
+        // operating system instead.
+        return params_.codec != AudioCodec::kAAC ||
+               avcodec_find_decoder(AV_CODEC_ID_AAC) != nullptr;
       default:
         return true;
     }
@@ -332,12 +337,13 @@ class AudioDecoderTest
         reader_->codec_context_for_testing(), EncryptionScheme::kUnencrypted,
