-#define CONFIG_H264_DECODER 1
+#define CONFIG_H264_DECODER 0
 #define CONFIG_H264_V4L2M2M_DECODER 0
 #define CONFIG_H264_MEDIACODEC_DECODER 0
 #define CONFIG_H264_MMAL_DECODER 0
@@ -344,7 +344,7 @@
