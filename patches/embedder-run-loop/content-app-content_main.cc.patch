Reason: lets an embedder host the browser process in its own, already
running run loop: ContentMainParams::embedder_owns_run_loop makes
RunContentProcess() return without ContentMainRunner::Shutdown() (the
embedder calls it at quit) and without handing BrowserMainLoop a pointer to
its stack autorelease pool, which would dangle. Default false: unchanged for
Chromium's apps. Used by notolibra/engine (plan.md §2.4). No upstream bug.

diff --git a/content/app/content_main.cc b/content/app/content_main.cc
index 0fd60fa820..9c7052356a 100644
--- a/content/app/content_main.cc
+++ b/content/app/content_main.cc
@@ -191,6 +191,7 @@ NO_STACK_PROTECTOR int RunContentProcess(
     ContentMainRunner* content_main_runner) {
   base::FeatureList::FailOnFeatureAccessWithoutFeatureList();
   int exit_code = -1;
+  const bool embedder_owns_run_loop = params.embedder_owns_run_loop;
 #if BUILDFLAG(IS_MAC)
   base::apple::ScopedNSAutoreleasePool autorelease_pool;
 #endif
@@ -284,7 +285,10 @@ NO_STACK_PROTECTOR int RunContentProcess(
     // is not safe. Each main loop should create and destroy its own pool; it
     // should not be flushing the pool at the base of the autorelease pool
     // stack.
-    params.autorelease_pool = &autorelease_pool;
+    // An embedder's run loop outlives this stack frame, and its pool.
+    if (!embedder_owns_run_loop) {
+      params.autorelease_pool = &autorelease_pool;
+    }
     InitializeMac();
 #endif
 
@@ -337,7 +341,9 @@ NO_STACK_PROTECTOR int RunContentProcess(
   exit_code = content_main_runner->Run();
 
 #if !BUILDFLAG(IS_ANDROID) && !BUILDFLAG(IS_IOS)
-  content_main_runner->Shutdown();
+  if (!embedder_owns_run_loop) {
+    content_main_runner->Shutdown();
+  }
 #endif
 
   return exit_code;
